# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true
COPY . .
RUN npm run build && npm prune --omit=dev --offline --ignore-scripts --no-audit --no-fund && mkdir /runtime && cp -a dist public node_modules db package.json package-lock.json LICENSE /runtime/ && mkdir /runtime/scripts && cp scripts/release-start.sh scripts/release-ops.sh /runtime/scripts/ && chmod -R a+rX /runtime
FROM node:24-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 DATA_DIR=/app/data KEYS_DIR=/app/keys
WORKDIR /app
RUN mkdir -p /app/data /app/keys && chown node:node /app/data /app/keys && chmod 700 /app/data /app/keys
COPY --from=build /runtime /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist/server/src/lite/main.js"]
