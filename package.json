{
  "name": "baize-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/server/worker-main.ts",
    "build": "npm run build:tracker && vite build && tsc -p tsconfig.server.json",
    "build:tracker": "tsx scripts/build-tracker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "cheerio": "^1.1.2",
    "echarts": "^6.0.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.7.0",
    "ipaddr.js": "^2.2.0",
    "maxmind": "^5.0.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrweb": "^2.0.0-alpha.18",
    "tdigest": "^0.1.2",
    "tldts": "7.4.18",
    "ua-parser-js": "1.0.41",
    "undici": "^7.16.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tdigest": "^0.1.5",
    "@types/ua-parser-js": "0.7.39",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.37.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
