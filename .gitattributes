* text=auto

# Keep Linux entrypoints free of CRLF on Windows checkouts.
*.sh text eol=lf
# Historical archive checksums bind the committed LF bytes.
docs/archive/** text eol=lf
# Preserve licensed geography assets and their provenance checksums on Windows.
packages/geography/** text eol=lf
packages/ip2region-data/** text eol=lf
db/migrations/062_bot_visit_log.sql text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
